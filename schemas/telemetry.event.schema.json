{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProcessOS Telemetry Event Schema",
  "description": "Event format for telemetry emission (Sprint 1: file/queue stub only; DB schema in Sprint 3)",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "run_id",
    "event_type",
    "criticality"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier (UUID)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when event occurred",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "description": "Associated run identifier",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "description": "Associated step (if applicable)"
    },
    "agent_id": {
      "type": "string",
      "description": "Associated agent (if applicable)"
    },
    "event_type": {
      "type": "string",
      "description": "Category of event",
      "enum": [
        "run_started",
        "run_completed",
        "run_failed",
        "step_started",
        "step_completed",
        "step_failed",
        "gate_passed",
        "gate_failed",
        "artifact_registered",
        "tool_call",
        "error",
        "cost_recorded"
      ]
    },
    "criticality": {
      "type": "string",
      "description": "Event importance level for filtering + degradation",
      "enum": ["critical", "high", "normal"],
      "notes": "Critical events: run_started/ended, step_started/ended, gate_passed/failed, artifact_registered, error, cost_recorded. High: tool_call, state_checkpoint. Normal: debug logs, intermediate reasoning."
    },
    "data": {
      "type": "object",
      "description": "Event-specific payload (varies by event_type)",
      "properties": {
        "gate_name": {
          "type": "string"
        },
        "gate_result": {
          "type": "boolean"
        },
        "gate_reason": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "artifact_path": {
          "type": "string"
        },
        "error_message": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "tool_input": {
          "type": "object"
        },
        "tool_output": {
          "type": "object"
        }
      }
    },
    "refs": {
      "type": "array",
      "description": "References to related artifacts or state snapshots",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["artifact", "state", "agent_view"]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "description": "Cost metrics for the event (if applicable)",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false
}
